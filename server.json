{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Aethelgard-Systems/lookfirst",
  "description": "MCP proxy with preview, human approval, read-back and a signed audit log.",
  "repository": {
    "url": "https://github.com/Aethelgard-Systems/lookfirst",
    "source": "github"
  },
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "lookfirst",
      "version": "0.2.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--config",
          "value": "{config_path}",
          "variables": {
            "config_path": {
              "description": "Absolute path to an existing operator-managed lookfirst YAML configuration",
              "isRequired": true
            }
          }
        }
      ]
    }
  ]
}
